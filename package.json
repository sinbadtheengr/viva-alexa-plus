{
  "name": "viva-alexa-plus",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "An oral-exam examiner for Alexa+ — a self-hosted MCP server that runs timed, rubric-scored speaking exams by voice.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bench": "npm run build && node dist/bench/run.js",
    "bench:report": "npm run build && node dist/bench/run.js --report",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.5",
    "@anthropic-ai/sdk": "^0.125.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
